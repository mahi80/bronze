# Copy to .env. The pipeline runs without any of this; only the agents need a model provider.

# none | anthropic | openai_compat | replay
LLM_PROVIDER=none
LLM_API_KEY=

# --- Anthropic: models default to claude-haiku-5-5 (classification) and claude-sonnet-5-5 (rule proposal)
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...

# --- Any OpenAI-compatible endpoint (OpenAI, a gateway, or a local server such as Ollama or llama.cpp)
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL_SMALL=<model your endpoint serves>
# LLM_MODEL_STRONG=<model your endpoint serves>

# Hard cap on tokens per command. When it is reached, classification stops and the load continues.
LLM_TOKEN_BUDGET=400000
# Sent to OpenAI-compatible endpoints only; leave empty to use the provider default.
LLM_TEMPERATURE=0
# USD per million tokens, for the cost estimate when the model is not in the built-in price list.
LLM_PRICE_IN=
LLM_PRICE_OUT=

# Time zone of the source system. Epoch timestamps are converted to it; naive timestamps are kept as written.
SOURCE_TZ=UTC
# Name recorded on approvals.
APPROVER=reviewer

# --- Operator console (part of the default docker compose up; the pipeline does not need it)
# Shared secret between the console's server and the API. The browser never sees it. Change it for anything
# beyond your own machine.
CONSOLE_API_TOKEN=local-console-token
