# Settings for running the console without Docker (copy to .env.local). Server-side only: never prefix with NEXT_PUBLIC_.
PIPELINE_API_URL=http://127.0.0.1:8000
# Must equal the CONSOLE_API_TOKEN the API was started with. The browser never sees it.
CONSOLE_API_TOKEN=
# Addresses the console may be opened under (comma-separated). Changes are refused from anywhere else.
CONSOLE_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
